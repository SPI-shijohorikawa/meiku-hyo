{
  "manifest_version": 3,
  "name": "メイク表 TMS取込（四条堀川）",
  "version": "2.5",
  "description": "メイク表のページの「TMS取込」ボタンから、TMSの予約検索（RESV・C/IN）をページが指定した日数だけ読みます。部屋番号・何泊目/何泊・部屋タイプだけを読みます。",
  "permissions": ["scripting", "tabs", "declarativeNetRequest"],
  "host_permissions": ["https://v4.tms.ninehours.co.jp/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://spi-shijohorikawa.github.io/meiku-hyo/*"],
    "js": ["content.js"],
    "run_at": "document_start"
  }]
}
